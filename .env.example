# Gemini / assistant (server-only)
# Visitors never provide an API key. Set one of these in .env.local or the host.
GEMINI_API_KEY=
# GOOGLE_API_KEY is used only when GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=

# Model selection
# Default / production rollback: gemini-2.5-flash
# Local/preview candidate: gemini-2.5-flash-lite
# Leave unset to keep the current production default. An existing GEMINI_MODEL
# value is preserved and is not rewritten by the app.
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash

# Assistant runtime (optional; defaults shown)
# ASSISTANT_ENABLED=true
# ASSISTANT_MAX_INPUT_TOKENS=16000
# ASSISTANT_MAX_OUTPUT_TOKENS=1024
# ASSISTANT_GENERATION_TIMEOUT_MS=30000

# Mocked tests stay isolated. Real provider evidence is opt-in only:
# ASSISTANT_LIVE_CHECK=1

# Assistant spend controls (modeled Gemini API charges only)
# This is an application budget, not a cap on the Google or Vercel invoice.
# Do not treat billing alerts as spending caps.
# ASSISTANT_REQUESTS_PER_MINUTE=10
# ASSISTANT_REQUESTS_PER_DAY=100
# ASSISTANT_DAILY_BUDGET_USD=1
# ASSISTANT_MONTHLY_BUDGET_USD=10
# ASSISTANT_MAX_BODY_BYTES=262144
# ASSISTANT_MAX_USER_MESSAGE_CHARS=4000
# ASSISTANT_MAX_TOOL_RESULT_CHARS=8000
# ASSISTANT_MAX_MODEL_CALLS_PER_REQUEST=4
# Local development defaults to in-memory storage. Production and preview
# require Neon (the existing DATABASE_URL family) after assistant-spend-schema.sql
# is applied in the Neon SQL editor. Do not set ASSISTANT_SPEND_STORE=memory
# outside local development.
# ASSISTANT_SPEND_STORE=neon
