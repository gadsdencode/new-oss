# Overture assistant — ICDU provider (server-only)
# Visitors never provide an API key. Set these in .env.local or the host secret store.
# Do not prefix them with NEXT_PUBLIC. Do not commit a real key.
ASSISTANT_PROVIDER=icdu
ICDU_API_BASE_URL=https://icdu-api.uterpi.com/v1
ICDU_MODEL=icdu
ICDU_API_KEY=

# The model endpoint does not include the icdu.ai knowledge database.
# Published Overture content is retrieved from this repository and, after
# ingestion, from the Neon collection in database/overture-knowledge-schema.sql.
# ICDU_EMBED_MODEL=icdu-embed-v1

# Assistant runtime (optional; defaults shown)
# ASSISTANT_ENABLED=true
# ASSISTANT_MAX_INPUT_TOKENS=16000
# ICDU chat output is capped at 2048 tokens by the shared gateway.
# ASSISTANT_MAX_OUTPUT_TOKENS=1024
# ASSISTANT_GENERATION_TIMEOUT_MS=120000
# The route function allows 300 seconds so a turn can include queue wait, generation, and tool continuations.

# Mocked tests stay isolated. Real provider evidence is opt-in only:
# ASSISTANT_LIVE_CHECK=1

# Visitor abuse controls. ICDU has no external per-token provider charge.
# Zero token pricing does not disable these limits. A visitor message is
# counted once per hour even when tools continue the same turn.
# ASSISTANT_REQUESTS_PER_MINUTE=10
# ASSISTANT_REQUESTS_PER_HOUR=25
# ASSISTANT_REQUESTS_PER_DAY=100
# ASSISTANT_MAX_BODY_BYTES=262144
# ASSISTANT_MAX_USER_MESSAGE_CHARS=4000
# ASSISTANT_MAX_TOOL_RESULT_CHARS=8000
# ASSISTANT_MAX_MODEL_CALLS_PER_REQUEST=4
# ASSISTANT_MAX_TOOL_EVENTS_PER_TURN=6

# Shared production enforcement uses the existing Neon DATABASE_URL family.
# Apply database/assistant-spend-schema.sql, then database/assistant-icdu-migration.sql,
# in the Neon SQL editor. Do not set ASSISTANT_SPEND_STORE=memory outside local development.
# ASSISTANT_SPEND_STORE=neon

# Dollar budgets apply only to the explicit Gemini rollback below.
# They are an application budget, not a hosting invoice cap.
# ASSISTANT_DAILY_BUDGET_USD=1
# ASSISTANT_MONTHLY_BUDGET_USD=10

# Explicit Gemini rollback only. The app never selects this automatically.
# ASSISTANT_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY is used only when GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
